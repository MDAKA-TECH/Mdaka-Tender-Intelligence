# Copy to worker/.env. Supabase → Project Settings → API.
SUPABASE_URL=https://qwpovznioeicizixdpqa.supabase.co
# service_role key: full database access. Server only. Never commit it, never put it in the React app.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
POLL_SECONDS=5

# ---- AI extraction (week 3) ----
# Pick ONE provider and paste only that provider's key. Model names change: check your provider's docs.
# Provider: anthropic | openai | gemini
LLM_PROVIDER=gemini
# Use the exact model name shown in your provider's console. Testing phase: a free Gemini Flash model from aistudio.google.com.
# Free-tier Gemini prompts may be read by Google: fine for public tenders, switch to a paid key before client pilots.
LLM_MODEL=gemini-3-flash-preview
# Optional: used if the main model is overloaded (503). Use a Flash-Lite name from AI Studio.
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
